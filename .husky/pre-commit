#!/bin/bash
set -o pipefail
IFS=$'\n\t'

npm run lint
npm run yaml-validate .github/workflows/build_branch.yml
npm run yaml-validate .github/workflows/build_main.yml
npm run yaml-validate .github/workflows/release.yml
npm run yaml-validate .github/workflows/dependabot_automerge.yml
npm run yaml-validate .github/dependabot.yml
sed -i -e "s#https://npm.uhlme.ch/#https://registry.npmjs.org/#g" package-lock.json
npm run test:unit
# The e2e Test often make problems when the chrome version is mismatching
# npm run test:e2e
git diff --name-only --cached --diff-filter=d | xargs -l git add
